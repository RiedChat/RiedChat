    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
